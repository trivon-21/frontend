{
    "extends": "stylelint-config-standard",
    "rules": {
        "color-no-hex": true,
        "declaration-property-value-allowed-list": {
            "margin": [
                "/var\\(/",
                "0",
                "auto"
            ],
            "padding": [
                "/var\\(/",
                "0"
            ],
            "color": [
                "/var\\(/",
                "transparent",
                "inherit"
            ],
            "background-color": [
                "/var\\(/",
                "transparent"
            ]
        }
    }
}